.env
.env.*
node_modules/
__pycache__/
.venv/
.DS_Store

# Ingested chain data: large, regenerable, and not the deliverable
ingest/out/

# Per-address detail views: 53,222 files, 186 MB, one per qualifying and
# non-qualifying address. Regenerated by export/build_leaderboard.py from
# ingest/out/. The leaderboard JSONs alongside them are committed; these are
# not, because 53k files makes every clone and status slow for no gain.
web/data/address/

# The store and the proxy cache: built artefacts, and on a deploy they live on the volume.
var/

# Built by export/build_leaderboard.py on every cycle, and duplicated into the store the
# API actually serves. Tracking them meant ~7 MB of new blobs every 15 minutes.
web/data/leaderboard/
web/data/tokens.json

# Ad-hoc archives. peapod-webdata.tar.gz was swept in by `git add -A` and cost 32 MB.
*.tar.gz
